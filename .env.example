# ---------------------------------------------------------------------------
# AI Lead Hunter configuration. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# DEMO_MODE=true enables the clearly-labelled fictional demo provider. Real providers still work.
DEMO_MODE=true

# Security — generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Optional dedicated Fernet key for encrypting provider secrets stored in the DB
# (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=
# Set true when served over HTTPS
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000

# Database (docker compose builds DATABASE_URL from these)
POSTGRES_USER=leadhunter
POSTGRES_PASSWORD=leadhunter
POSTGRES_DB=leadhunter

# AI — Anthropic preferred; OpenAI optional (pip extra "openai")
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_PROVIDER=anthropic
# DeepSeek (OpenAI-compatible API). Models: deepseek-flash (fast, cheap) or deepseek-v4-pro.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Discovery & enrichment providers (all optional; unconfigured providers are shown as "Requires API key")
BRAVE_API_KEY=
HUNTER_API_KEY=
X_BEARER_TOKEN=
FIRECRAWL_API_KEY=
GOOGLE_SHEETS_CREDENTIALS_JSON=
N8N_WEBHOOK_URL=
CRM_WEBHOOK_URL=

# Free sources (no key): OpenStreetMap discovery, CSV/Excel import, schema.org + sitemap parsing, DNS MX email check.
# Optional real contact email for the OSM User-Agent (leave empty rather than using a placeholder).
OSM_CONTACT_EMAIL=
OSM_CITY_RADIUS_KM=25
EMAIL_MX_CHECK=true

# Direct scraping with headless Chromium (Google Maps discovery + public Instagram/Facebook/Snapchat/TikTok pages).
# Limits: no login, no captcha solving, no proxy rotation; a block stops that source with a clear message.
SCRAPING_ENABLED=false
SCRAPER_MAX_PLACES_PER_CAMPAIGN=60
SCRAPER_DELAY_MIN=2
SCRAPER_DELAY_MAX=5
SOCIAL_ENRICHMENT_ENABLED=true
# Search Instagram/Facebook/TikTok/Snapchat by business name when the business published no link.
# Needs a connected Brave Search API key (official API). Daily cap per workspace.
SOCIAL_SEARCH_ENABLED=false
SOCIAL_SEARCH_DAILY_LIMIT=200

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Shared secret between the bot process and the API (any long random string)
TELEGRAM_SERVICE_TOKEN=change-me-service-token
# Production webhook mode (leave TELEGRAM_WEBHOOK_URL empty for long polling)
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Cost tracking (USD) used for budgets when providers don't report cost
COST_BRAVE_PER_REQUEST=0.005
COST_HUNTER_PER_REQUEST=0.01
COST_AI_INPUT_PER_MTOK=4.0
COST_AI_OUTPUT_PER_MTOK=20.0
DATA_RETENTION_DAYS=365
